<main class="mx-auto flex-1 px-4 md:px-6">
    <div id="titlelogo">
        <div class="mx-auto space-y-6 py-12 md:py-24 lg:py-2">
            <p>
                <img src={AebcWeb.UrlHelper.strapi_url("/uploads/aebc_logo2_f4d8cfdfc6.webp")} alt="aebc-logo2.webp" srcset={AebcWeb.UrlHelper.strapi_url("/uploads/thumbnail_aebc_logo2_f4d8cfdfc6.webp") <> " 245w," <> AebcWeb.UrlHelper.strapi_url("/uploads/small_aebc_logo2_f4d8cfdfc6.webp") <> " 500w," <> AebcWeb.UrlHelper.strapi_url("/uploads/medium_aebc_logo2_f4d8cfdfc6.webp") <> " 750w,"} sizes="100vw" width="960" height="519">
            </p>
        </div>
    </div>
    <div class="max-w-88">
      <%= if @content do %>
        <%= raw(@content["main"]) %>
      <% end %>
    </div>

<div class="container mx-auto px-4 py-8">
  <!-- Intro Text -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold leading-tight md:text-4xl">
      <span>致力于比利时、中国多方面交流的平台</span> Association d'échanges belgo-chinois
    </h1>
    <p class="text-lg text-[#3D52A0] mt-2">
      <span class="bg-white px-1">Cours, ateliers, évènements autour de la culture chinoise.</span>
    </p>
  </div>

  <!-- Grid Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Left Column: News + Events -->
    <div class="space-y-6">
      <!-- Latest News -->
      <div>
        <h2 class="text-xl font-semibold text-[#3D52A0] mb-2">
          <%= gettext("Latest News.") %>
        </h2>
        <ul class="list-disc list-inside space-y-1">
          <%= for news <- @latest_news do %>
            <li>
              <.link navigate={~p"/posts/#{news["id"]}"} class="text-blue-600 hover:underline">
                <%= news["name"] %>
              </.link>
            </li>
          <% end %>
        </ul>
      </div>

      <!-- Latest Events -->
      <div>
        <h2 class="text-xl font-semibold text-[#3D52A0] mb-2">
          <%= gettext("Latest Events.") %>
        </h2>
        <ul class="list-disc list-inside space-y-1">
          <%= for event <- @events do %>
            <li>
              <a href={"/events/#{event["id"]}"} class="text-blue-600 hover:underline">
                <%= raw(event["name"]) %>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <!-- Right Column: Calendar -->
    <div>
      <iframe
        src="https://calendar.google.com/calendar/embed?height=500&amp;wkst=2&amp;ctz=Europe%2FParis&amp;showPrint=0&amp;title=AEBC%20Events&amp;src=M2YzZmE2ZjQ4MTkyNGIwNzNhZTllODM2Njk5ZDkwZDM1MzRkNWE2YjcyNjhmYjY4MmI4MDViMWYyMzU4NzMwZkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&amp;color=%23C0CA33"
        class="w-full h-[500px] border border-gray-300 rounded"
        frameborder="0"
        scrolling="no"
      ></iframe>
    </div>
  </div>
</div>

</main>