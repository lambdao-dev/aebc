<main class="mx-auto flex-1 px-4 md:px-6">
    <div id="titlelogo">
        <div class="mx-auto space-y-6 py-12 md:py-24 lg:py-2">
            <p>
                <img src="http://localhost:1337/uploads/aebc_logo2_f4d8cfdfc6.webp" alt="aebc-logo2.webp" srcset="http://localhost:1337/uploads/thumbnail_aebc_logo2_f4d8cfdfc6.webp 245w,http://localhost:1337/uploads/small_aebc_logo2_f4d8cfdfc6.webp 500w,http://localhost:1337/uploads/medium_aebc_logo2_f4d8cfdfc6.webp 750w," sizes="100vw" width="960" height="519">
            </p>
        </div>
    </div>
    <div>
      <%= if @content do %>
        <%= raw(@content["main"]) %>
      <% end %>
    </div>
    <div class="flex flex-col md:flex-row">
        <div class="w-full md:w-1/3 p-2">
            <div class="flexbox-h-container">
                <h1 class="text-3xl font-bold leading-tight md:text-3xl lg:text-3xl">
                    <span class="bg-gradient-to-r from-[#00a8e8] to-[#0077b6] bg-clip-text dark:text-white">致力于比利时、中国多方面交流的平台 </span>Association d'échanges belgo-chinois
                </h1>
            </div>
            <div class="flexbox-h-container">
                <p class="text-lg text-[#3D52A0] md:text-xl">
                    <span class="white_bg">Cours, ateliers, évènements autour de la culture chinoise.</span>
                </p>
            </div>
        </div>
        <div class="w-full md:w-2/3 p-2">
            <iframe style="border:1px solid #777;min-height:600px;min-width:90%;" src="https://calendar.google.com/calendar/embed?height=500&amp;wkst=2&amp;ctz=Europe%2FParis&amp;showPrint=0&amp;title=AEBC%20Events&amp;src=M2YzZmE2ZjQ4MTkyNGIwNzNhZTllODM2Njk5ZDkwZDM1MzRkNWE2YjcyNjhmYjY4MmI4MDViMWYyMzU4NzMwZkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&amp;color=%23C0CA33" width="100%" frameborder="0" scrolling="no"></iframe>
        </div>
    </div>
</main>